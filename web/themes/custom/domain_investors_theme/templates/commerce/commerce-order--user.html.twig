{#
/**
 * @file
 * A buyer's order: where it stands, the domains, what was paid, and how to
 * pay what is due.
 */
#}
<article{{ attributes.addClass('pf-order', 'pf-stack', 'pf-gap-6') }}>
  <dl class="pf-order-status">
    <div><dt class="ui-label">{{ 'Placed'|t }}</dt><dd>{{ facts.placed }}</dd></div>
    <div><dt class="ui-label">{{ 'Status'|t }}</dt><dd>{{ facts.state }}</dd></div>
    <div><dt class="ui-label">{{ 'Payment'|t }}</dt>
      <dd>
        {% if facts.paid %}
          <span class="dp-badge dp-badge-accent">{{ 'Paid'|t }}</span>
        {% elseif facts.balance %}
          <span class="dp-badge dp-badge-notice">{{ '@amount due'|t({ '@amount': facts.balance }) }}</span>
        {% endif %}
      </dd>
    </div>
  </dl>

  <section class="pf-summary">
    <ul class="pf-summary-items">
      {% for item in facts.items %}
        <li>
          {{ include('domain_investors_theme:domain-name', { name: item.name, size: 'lg' }, with_context = false) }}
          <span class="fig-price">{{ item.price }}</span>
        </li>
      {% endfor %}
    </ul>
    <dl class="pf-summary-totals">
      {% if facts.adjustments %}
        <div><dt>{{ 'Subtotal'|t }}</dt><dd class="fig-data">{{ facts.subtotal }}</dd></div>
        {% for adjustment in facts.adjustments %}
          <div><dt>{{ adjustment.label }}</dt><dd class="fig-data">{{ adjustment.amount }}</dd></div>
        {% endfor %}
      {% endif %}
      <div class="pf-summary-total"><dt>{{ 'Total'|t }}</dt><dd class="fig-price">{{ facts.total }}</dd></div>
    </dl>
  </section>

  {% if facts.lease %}
    <section class="pf-stack pf-gap-3">
      <h2 class="ui-heading">{{ 'Lease to own'|t }}</h2>
      <dl class="pf-facts">
        <div><dt class="ui-label">{{ 'Paid'|t }}</dt><dd class="fig-price">{{ facts.lease.paid }}</dd></div>
        <div><dt class="ui-label">{{ 'Left to pay'|t }}</dt><dd class="fig-price">{{ facts.lease.remaining }}</dd></div>
        <div><dt class="ui-label">{{ 'Monthly payments'|t }}</dt><dd class="fig-price">{{ '@made of @months'|t({ '@made': facts.lease.made, '@months': facts.lease.months }) }}</dd></div>
        {% if facts.lease.next %}
          <div><dt class="ui-label">{{ 'Next payment'|t }}</dt><dd class="fig-price">{{ facts.lease.next }}{% if facts.lease.due %} · {{ facts.lease.due }}{% endif %}</dd></div>
        {% endif %}
      </dl>
    </section>
  {% endif %}

  {% if facts.instructions %}
    <section class="pf-order-pay pf-stack pf-gap-3">
      <h2 class="ui-heading">{{ 'How to pay'|t }}</h2>
      <div class="ui-body">{{ facts.instructions }}</div>
    </section>
  {% endif %}

  <p class="ui-body-sm pf-muted">{{ 'Questions about this order? Write to us from the contact page, quoting order @number.'|t({ '@number': facts.number }) }} <a href="{{ path('contact.site_page') }}">{{ 'Contact'|t }}</a></p>
</article>
