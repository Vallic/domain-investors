{#
/**
 * @file
 * The domain search: the search bar, then the names found as cards.
 */
#}
<div{{ attributes.addClass('pf-search', 'pf-stack', 'pf-gap-6') }}>
  {% if exposed %}<div>{{ exposed }}</div>{% endif %}
  {% if searched %}
    <p class="fig-data pf-muted">{{ total == 1 ? '1 name found'|t : '@count names found'|t({ '@count': total }) }}</p>
  {% endif %}
  {% if domains %}
    <div class="pf-cards">
      {% for domain in domains %}{{ include('portfolio:domain-card', { domain: domain }, with_context = false) }}{% endfor %}
    </div>
    {% if pager %}<nav class="pf-pager" aria-label="{{ 'Pages'|t }}">{{ pager }}</nav>{% endif %}
  {% elseif searched %}
    {% include '@portfolio/includes/empty.html.twig' %}
  {% endif %}
</div>
